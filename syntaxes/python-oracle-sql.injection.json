{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Oracle SQL in Python",
  "scopeName": "sql-developer-companion.python-oracle-sql.injection",
  "injectionSelector": "L:source.python -comment -string",
  "patterns": [
    {
      "include": "#assigned-f-sql"
    },
    {
      "include": "#assigned-sql"
    },
    {
      "include": "#executed-sql"
    },
    {
      "include": "#executed-sql-next-line"
    },
    {
      "include": "#parenthesized-sql"
    }
  ],
  "repository": {
    "oracle-sql": {
      "patterns": [
        {
          "include": "#oracle-qualified-call"
        },
        {
          "include": "#oracle-named-argument"
        },
        {
          "include": "#oracle-bind-variable"
        },
        {
          "include": "source.oracle-sql"
        }
      ]
    },
    "oracle-qualified-call": {
      "match": "(?ix)\\b([A-Z_][A-Z0-9_$#]*)(\\.)([A-Z_][A-Z0-9_$#]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.namespace.oracle-sql"
        },
        "2": {
          "name": "punctuation.accessor.oracle-sql"
        },
        "3": {
          "name": "entity.name.function.oracle-sql"
        }
      }
    },
    "oracle-named-argument": {
      "match": "(?ix)\\b([A-Z_][A-Z0-9_$#]*)(\\s*)(=>)",
      "captures": {
        "1": {
          "name": "variable.parameter.oracle-sql"
        },
        "3": {
          "name": "keyword.operator.assignment.oracle-sql"
        }
      }
    },
    "oracle-bind-variable": {
      "match": "(?ix)(:)([A-Z_][A-Z0-9_$#]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.variable.oracle-sql"
        },
        "2": {
          "name": "variable.other.readwrite.oracle-sql"
        }
      }
    },
    "assigned-f-sql": {
      "name": "meta.fstring.oracle-sql.python",
      "contentName": "meta.embedded.block.oracle-sql",
      "begin": "(?ix)\\b((?=[A-Z_])\\w*(?:sql|query|statement)\\w*|stmt|ddl|dml)\\s*(=)\\s*((?:fr|rf|f))(\"\"\"|''')",
      "end": "\\4",
      "beginCaptures": {
        "1": {
          "name": "variable.other.readwrite.python"
        },
        "2": {
          "name": "keyword.operator.assignment.python"
        },
        "3": {
          "name": "storage.type.string.python"
        },
        "4": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "#python-f-interpolation"
        },
        {
          "include": "#oracle-sql"
        }
      ]
    },
    "python-f-interpolation": {
      "name": "meta.embedded.expression.python",
      "begin": "(?<!\\{)(\\{)(?!\\{)",
      "end": "(?<!\\})(\\})(?!\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.python"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.python"
        }
      },
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },
    "assigned-sql": {
      "name": "meta.assignment.oracle-sql.python",
      "contentName": "meta.embedded.block.oracle-sql",
      "begin": "(?ix)\\b((?=[A-Z_])\\w*(?:sql|query|statement)\\w*|stmt|ddl|dml)\\s*(=)\\s*(?:[ru]{0,2})(\"\"\"|''')",
      "end": "\\3",
      "beginCaptures": {
        "1": {
          "name": "variable.other.readwrite.python"
        },
        "2": {
          "name": "keyword.operator.assignment.python"
        },
        "3": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "#oracle-sql"
        }
      ]
    },
    "executed-sql": {
      "name": "meta.function-call.oracle-sql.python",
      "contentName": "meta.embedded.block.oracle-sql",
      "begin": "(?ix)\\b([A-Z_]\\w*\\s*\\.\\s*(?:execute|executemany)\\s*\\(\\s*)(?:[ru]{0,2})(\"\"\"|''')",
      "end": "\\2",
      "beginCaptures": {
        "1": {
          "name": "meta.function-call.python"
        },
        "2": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "#oracle-sql"
        }
      ]
    },
    "executed-sql-next-line": {
      "name": "meta.function-call.oracle-sql.python",
      "begin": "(?ix)\\b([A-Z_]\\w*\\s*\\.\\s*(?:execute|executemany)\\s*\\()[^\\S\\r\\n]*$",
      "end": "(?=[^\\S\\r\\n]*(?:,|\\)))",
      "patterns": [
        {
          "include": "#executed-sql-next-line-string"
        },
        {
          "include": "#executed-sql-next-line-inline-string"
        },
        {
          "include": "#executed-sql-next-line-f-string"
        },
        {
          "include": "source.python"
        }
      ]
    },
    "executed-sql-next-line-string": {
      "name": "meta.function-call.oracle-sql.python",
      "contentName": "meta.embedded.block.oracle-sql",
      "begin": "(?ix)^[^\\S\\r\\n]*(?:[ru]{0,2})(\"\"\"|''')",
      "end": "\\1",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "#oracle-sql"
        }
      ]
    },
    "executed-sql-next-line-inline-string": {
      "name": "string.quoted.oracle-sql.python",
      "contentName": "meta.embedded.inline.oracle-sql",
      "begin": "(?ix)^[^\\S\\r\\n]*(?:[ru]{0,2})(\"|')",
      "end": "\\1",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "#python-string-escape"
        },
        {
          "include": "#oracle-sql"
        }
      ]
    },
    "executed-sql-next-line-f-string": {
      "name": "string.quoted.oracle-sql.python",
      "contentName": "meta.embedded.inline.oracle-sql",
      "begin": "(?ix)^[^\\S\\r\\n]*(?:fr|rf|f)(\"|')",
      "end": "\\1",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "#python-f-interpolation"
        },
        {
          "include": "#python-string-escape"
        },
        {
          "include": "#oracle-sql"
        }
      ]
    },
    "parenthesized-sql": {
      "name": "meta.assignment.oracle-sql.python",
      "begin": "(?ix)\\b((?=[A-Z_])\\w*(?:sql|query|statement)\\w*|stmt|ddl|dml)\\s*(=)\\s*(\\()",
      "end": "(\\))",
      "beginCaptures": {
        "1": {
          "name": "variable.other.readwrite.python"
        },
        "2": {
          "name": "keyword.operator.assignment.python"
        },
        "3": {
          "name": "punctuation.parenthesis.open.python"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.parenthesis.close.python"
        }
      },
      "patterns": [
        {
          "include": "#parenthesized-sql-comment"
        },
        {
          "include": "#parenthesized-sql-string"
        }
      ]
    },
    "parenthesized-sql-comment": {
      "name": "comment.line.number-sign.python",
      "begin": "#",
      "end": "$"
    },
    "parenthesized-sql-string": {
      "name": "string.quoted.oracle-sql.python",
      "contentName": "meta.embedded.inline.oracle-sql",
      "begin": "(?ix)(?:[ru]{0,2})(\"\"\"|'''|\"|')",
      "end": "\\1",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "#python-string-escape"
        },
        {
          "include": "#oracle-sql"
        }
      ]
    },
    "python-string-escape": {
      "name": "constant.character.escape.python",
      "match": "\\\\."
    }
  }
}
